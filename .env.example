# Vercel Deployment Required Environment Variables

# The URL of your Supabase project (e.g., https://xxxxxxxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Anon key for client-side and public server actions (insert queries with RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The Service Role Key to bypass RLS for server-side admin dashboard (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Password for the /admin dashboard to view messages and subscribers
ADMIN_PASSWORD=

# 32+ byte random hex string for signing admin session cookies
SESSION_SECRET=
